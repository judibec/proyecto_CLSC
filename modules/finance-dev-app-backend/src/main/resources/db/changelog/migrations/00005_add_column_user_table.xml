<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <property name="table.name" value="user" global="false"/>

    <changeSet author="Juan Becerra" id="00005_add_column_${table.name}_table">
        <preConditions onFail="MARK_RAN" onFailMessage="column finance_id in ${table.name} already exists">
            <not>
                <columnExists tableName="${table.name}" columnName="finance_id"/>
            </not>
        </preConditions>
        <addColumn  tableName="${table.name}" >
            <column  name="finance_id" type="${type.id}">
                <constraints nullable="true" foreignKeyName="FK_user_finance_id" referencedTableName="finance" referencedColumnNames="id"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>