<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <property name="table.name" value="expenses" global="false"/>

    <changeSet author="Juan Becerra" id="00007_create_${table.name}_table">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onFailMessage="Table ${table.name} already exists">
            <not>
                <tableExists tableName="${table.name}" />
            </not>
        </preConditions>

        <createTable tableName="${table.name}">
            <!-- general properties -->
            <column name="id"          type="${type.id}"   autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="${table.name}_PK" />
            </column>
            <column name="external_id" type="${type.externalId}">
                <constraints nullable="false" unique="true" uniqueConstraintName="${table.name}_externalId_UK" />
            </column>
            <column name="description" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <!-- custom properties -->
            <column name="finance_id" type="${type.id}">
                <constraints nullable="true" foreignKeyName="FK_expense_finance_id" referencedTableName="finance" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>